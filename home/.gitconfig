[user]
	name = Ryoh Akiyoshi
	email = ryo614@gmail.com
[core]
	editor = /usr/bin/env nvim
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[init]
	defaultBranch = main
[push]
	default = current
	asdf
	autoSetupRemote = true
[pull]
	rebase = false
[url "ssh://git@github.com/"]
	insteadOf = "https://github.com/"
[alias]
	merged-branches = "!f() {\n  git for-each-ref --format=\"%(refname:short)\" refs/heads |\n  while read -r branch; do\n    case \"$branch\" in\n      main|master|develop)\n        continue\n        ;;\n    esac\n\n    if gh pr list \\\n      --head \"$branch\" \\\n      --state merged \\\n      --json number \\\n      --jq \"length > 0\" |\n      grep -q true\n    then\n      echo \"$branch\"\n    fi\n  done\n}; f"
	delete-merged-branches = "!f() {\n  git fetch --prune\n\n  git for-each-ref --format=\"%(refname:short)\" refs/heads |\n  while read -r branch; do\n    case \"$branch\" in\n      main|master|develop)\n        continue\n        ;;\n    esac\n\n    if gh pr list \\\n      --head \"$branch\" \\\n      --state merged \\\n      --json number \\\n      --jq \"length > 0\" |\n      grep -q true\n    then\n      echo \"Deleting: $branch\"\n      git branch -D \"$branch\"\n    fi\n  done\n}; f"
[include]
	path = ~/.gitconfig.local

